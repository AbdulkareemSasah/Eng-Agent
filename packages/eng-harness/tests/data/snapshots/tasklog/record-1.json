          "type": "string"
        },
        "by": {
          "pattern": "^(agent:.+|harness|dev-session:.+)$",
          "title": "By",
          "type": "string"
        },
        "kind": {
          "const": "did_instead",
          "title": "Kind",
          "type": "string"
        },
        "policy": {
          "enum": [
            "full",
            "sanitized"
