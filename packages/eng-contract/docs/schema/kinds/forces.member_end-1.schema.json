{
  "$defs": {
    "CaseRef": {
      "additionalProperties": false,
      "description": "A load pattern, case or combination; `step` is the envelope `Max`/`Min` or step number as the host reports it.",
      "properties": {
        "case": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Case",
          "type": "string"
        },
        "case_type": {
          "$ref": "#/$defs/CaseType"
        },
        "step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        }
      },
      "required": [
        "case",
        "case_type"
      ],
      "title": "CaseRef",
      "type": "object"
    },
    "CaseType": {
      "description": "What a `CaseRef` names.",
      "enum": [
        "load_pattern",
        "load_case",
        "load_combination"
      ],
      "title": "CaseType",
      "type": "string"
    },
    "MemberEndForce": {
      "additionalProperties": false,
      "description": "Internal forces of a member at `station_mm` from its i end; `end` is set when the row is an end value.",
      "properties": {
        "M2_kNm": {
          "title": "M2 Knm",
          "type": "number",
          "x-eng-unit": "kN.m"
        },
        "M3_kNm": {
          "title": "M3 Knm",
          "type": "number",
          "x-eng-unit": "kN.m"
        },
        "P_kN": {
          "title": "P Kn",
          "type": "number",
          "x-eng-unit": "kN"
        },
        "T_kNm": {
          "title": "T Knm",
          "type": "number",
          "x-eng-unit": "kN.m"
        },
        "V2_kN": {
          "title": "V2 Kn",
          "type": "number",
          "x-eng-unit": "kN"
        },
        "V3_kN": {
          "title": "V3 Kn",
          "type": "number",
          "x-eng-unit": "kN"
        },
        "case": {
          "$ref": "#/$defs/CaseRef"
        },
        "end": {
          "anyOf": [
            {
              "enum": [
                "i",
                "j"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End"
        },
        "member": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Member",
          "type": "string"
        },
        "station_mm": {
          "minimum": 0,
          "title": "Station Mm",
          "type": "number",
          "x-eng-unit": "mm"
        }
      },
      "required": [
        "member",
        "case",
        "end",
        "station_mm",
        "P_kN",
        "V2_kN",
        "V3_kN",
        "T_kNm",
        "M2_kNm",
        "M3_kNm"
      ],
      "title": "MemberEndForce",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`forces.member_end/1`: signs follow the host's local axes (gap G-3), recorded by `sign_convention`.",
  "properties": {
    "rows": {
      "items": {
        "$ref": "#/$defs/MemberEndForce"
      },
      "title": "Rows",
      "type": "array"
    },
    "sign_convention": {
      "const": "host_local/1",
      "title": "Sign Convention",
      "type": "string"
    }
  },
  "required": [
    "sign_convention",
    "rows"
  ],
  "title": "MemberEnd",
  "type": "object"
}
