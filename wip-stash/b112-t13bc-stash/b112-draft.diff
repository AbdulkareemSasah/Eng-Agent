+def test_resume_order_guards_reconciliation(tmp_path: Path) -> None:
+    """Preflight, lease and units run before reconciliation; guards leave the write in flight (AC62)."""
+    from eng_harness.errors import HarnessCode, RunRefused
+    from eng_harness.ports import ServerCheck, UnitsState
+
+    rig, host, run_id = _cut_off_write(tmp_path)
+    bad_build = ServerCheck(
+        server="csi", build="old", min_build="b", fingerprint="f", expected_fingerprint="f", ok=False, reason="old"
+    )
+    host.preflight_checks = [bad_build]
+    with pytest.raises(RunRefused) as refused:
+        resume(rig, chain(ORIGINAL), run_id)
+    assert refused.value.code is HarnessCode.SERVER_CHECK_FAILED
+    assert [c[0] for c in host.calls if c[0] in ("reconcile", "model_state")] == []
+    host.preflight_checks = None
+    from eng_harness.ports import HostLease
+
+    host.leases["csi"] = HostLease(host_key="csi", lease_id="taken")
+    from eng_contract.errors import ContractError
+
+    with pytest.raises(ContractError) as locked:
+        resume(rig, chain(ORIGINAL), run_id)
+    assert locked.value.detail.code is ErrorCode.HOST_LOCKED
+    host.leases.clear()
+    host.units["m1"] = UnitsState(loaded=True, ok=False, present="b", expected="a")
+    stopped = resume(rig, chain(ORIGINAL), run_id)
+    assert stopped.status is RunStatus.NEEDS_ENGINEER
+    assert stopped.escalation is not None
+    assert stopped.escalation.reason == "units_mismatch"
